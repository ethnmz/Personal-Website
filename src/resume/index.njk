---
title: "ethnmz &mdash; resume"
---
{% extends "layouts/page.njk" %}
{% block pageStyle %}{% raw %}
      h1, h2, h3 {
        font-family: var(--header-font);
        color: var(--link-color);
        margin-top: 0;
        text-align: center;
      }

      /* --- TOP HEADER --- */
      .top-header {
        max-width: 900px;
        margin: 0 auto 20px auto;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 5px;
      }

      /* --- MAIN CONTENT STYLES --- */
      .path-bar {
        font-size: 0.9em;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 5px;
      }

      .page-header {
        font-size: 2em;
        text-align: left;
        border-bottom: 1px dashed var(--border-color);
        margin-bottom: 15px;
      }

      .page-desc {
        font-size: 0.95em;
        margin-bottom: 15px;
      }

      /* Resume specifics */
      .resume-download {
        display: block;
        text-align: center;
        background: var(--select-bg);
        border: 1px solid var(--border-color);
        color: var(--text-color);
        font-weight: bold;
        padding: 10px;
        margin-bottom: 15px;
      }

      .resume-download:hover {
        background: var(--border-color);
      }

      .resume-embed-wrap {
        width: 100%;
        border: 1px solid var(--border-color);
        background: var(--select-bg);
      }

      .resume-embed-wrap iframe {
        width: 100%;
        height: 780px;
        border: none;
        display: block;
      }

      .resume-fallback {
        text-align: center;
        font-size: 0.85em;
        padding: 10px;
      }
{% endraw %}{% endblock %}
{% block main %}{% raw %}      <main>

        <div class="box path-bar" data-scene="resume">
          <strong>resume</strong>
        </div>

        <div class="box">
          <h1 class="page-header">resume</h1>

          <p class="page-desc">
            Texas A&amp;M &#8226; Computer Science &#8226; <a href="mailto:ethan7714@tamu.edu">ethan7714@tamu.edu</a> &#8226; <a href="https://www.linkedin.com/in/ethnmz" target="_blank" rel="noopener">linkedin</a>
            <br><br><em>last updated: 9/12/26</em>
          </p>

          <a href="/media/resume.pdf" class="resume-download" download>&#8595; download resume (PDF)</a>

          <div class="resume-embed-wrap">
            <iframe src="/media/resume.pdf" title="Ethan Meza resume"></iframe>
          </div>
          <p class="resume-fallback">
            PDF not loading? <a href="/media/resume.pdf" target="_blank" rel="noopener">open it directly</a>.
          </p>
        </div>

      </main>

{% endraw %}{% endblock %}
