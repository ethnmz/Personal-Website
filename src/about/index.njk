                </button>
              </div>
            </div>
            <div class="fav-case" id="fav-case" data-tab="albums">
{% endraw %}              <div class="fav-panel fav-games" id="fav-games" role="tabpanel" aria-labelledby="fav-tab-games" data-label="{{ favorites.games | length }} games &middot; hover one" hidden>
{% for c in favorites.games %}                <img src="{{ c.img }}" class="fav-cover" alt="{{ c.alt | safe }}" style="--i: {{ loop.index0 }}">
{% endfor %}{% raw %}              </div>
{% endraw %}              <div class="fav-panel fav-albums" id="fav-albums" role="tabpanel" aria-labelledby="fav-tab-albums" data-label="{{ favorites.albums | length }} albums &middot; hover one">
{% for c in favorites.albums %}                <img src="{{ c.img }}" class="fav-cover" alt="{{ c.alt | safe }}" style="--i: {{ loop.index0 }}">
{% endfor %}{% raw %}              </div>
              <div class="fav-plaque" aria-hidden="true"></div>
            </div>
          </div>
        </div>

      </main>

{% endraw %}{% endblock %}
{% block scriptExtra %}{% raw %}
      (function () {
        var shelf = document.getElementById('fav-case');
        var plaque = shelf.querySelector('.fav-plaque');
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.fav-tab'));

        function openPanel() {
          return shelf.querySelector('.fav-panel:not([hidden])');
        }

        function resetPlaque() {
          plaque.textContent = openPanel().getAttribute('data-label');
        }

        function select(tab, focus) {
          if (tab.getAttribute('aria-selected') === 'true') return;
          tabs.forEach(function (t) {
            var on = t === tab;
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
          });
          if (focus) tab.focus();
          var panel = openPanel();
          panel.classList.remove('drop');
          void panel.offsetWidth;
          panel.classList.add('drop');
          shelf.setAttribute('data-tab', tab.getAttribute('data-tab'));
          resetPlaque();
          shelf.dispatchEvent(new CustomEvent('shelfchange'));
        }

        tabs.forEach(function (tab, i) {
          tab.addEventListener('click', function () { select(tab); });
          tab.addEventListener('keydown', function (e) {
            var next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
            if (next === undefined) return;
            e.preventDefault();
            select(tabs[(next + tabs.length) % tabs.length], true);
          });
        });

        shelf.addEventListener('mouseover', function (e) {
          var cover = e.target.closest('.fav-cover');
          if (cover) plaque.textContent = cover.alt.replace(/ cover art$/, '');
          else resetPlaque();
        });
        shelf.addEventListener('mouseleave', resetPlaque);
        resetPlaque();
      })();
{% endraw %}{% endblock %}
