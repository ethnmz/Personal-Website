---
title: "ethnmz &mdash; about"
---
{% extends "layouts/page.njk" %}
{% block pageStyle %}{% raw %}
      a:hover {
        font-style: italic;
      }

      .container > main {
        min-width: 0;
      }

      h1, h2, h3 {
        font-family: var(--header-font);
        color: var(--link-color);
        font-style: italic;
        margin-top: 0;
        text-align: center;
      }

      /* --- TOP HEADER --- */
      .top-header {
        max-width: 900px;
        margin: 0 auto 20px auto;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 5px;
        font-style: italic;
      }

      /* --- MAIN CONTENT STYLES --- */
      .path-bar {
        font-style: italic;
        font-size: 0.9em;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 5px;
      }

      .page-header {
        font-size: 2em;
        text-align: left;
        border-bottom: 1px dashed var(--border-color);
        margin-bottom: 15px;
        font-style: normal;
      }

      /* About Me */
      .about-header {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 10px;
      }

      .about-photo-frame {
        display: inline-block;
        position: relative;
        background: var(--box-bg);
        border: 3px double var(--border-color);
        padding: 8px 8px 22px 8px;
        box-shadow: 2px 3px 6px rgba(0,0,0,0.2);
        flex-shrink: 0;
        overflow: hidden;
      }

      .about-photo {
        width: 150px;
        height: 200px;
        object-fit: cover;
        border: 1px solid var(--border-color);
        display: block;
      }

      .about-photo-frame::after {
        content: '\2726';
        position: absolute;
        right: 6px;
        bottom: 2px;
        color: var(--link-color);
        font-size: 0.9em;
      }

      .about-bio {
        flex: 1;
        font-size: 0.95em;
      }

      @media (max-width: 500px) {
        .about-header {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
      }

      .favorites-section {
        margin-top: 20px;
      }

      /* Favorites cabinet: the pixel art wood is drawn by /assets/v2.js,
         so every size here is a multiple of its 3px pixel grid */
      .fav-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
        border-bottom: 3px double var(--border-color);
        padding-bottom: 6px;
      }

      .fav-head h3 {
        margin: 0;
        font-size: 1.1em;
        text-align: left;
      }

      .fav-tabs {
        display: flex;
        gap: 12px;
        padding: 3px 3px 0 0;
      }

      .fav-tab {
        --edge: var(--border-color);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 3px 9px;
        border: 0;
        background: var(--select-bg);
        color: var(--text-color);
        font-family: var(--body-font);
        font-size: 12px;
        font-weight: bold;
        cursor: var(--cursor-pointer);
        box-shadow:
          0 -3px 0 0 var(--edge), 0 3px 0 0 var(--edge), -3px 0 0 0 var(--edge), 3px 0 0 0 var(--edge),
          inset 3px 3px 0 0 rgba(255, 255, 255, 0.35), inset -3px -3px 0 0 rgba(0, 0, 0, 0.1);
      }

      .fav-tab:hover {
        --edge: var(--link-color);
      }

      .fav-tab[aria-selected="true"] {
        --edge: var(--link-color);
        background: var(--link-color);
        color: var(--box-bg);
        box-shadow:
          0 -3px 0 0 var(--edge), 0 3px 0 0 var(--edge), -3px 0 0 0 var(--edge), 3px 0 0 0 var(--edge),
          inset 3px 3px 0 0 rgba(0, 0, 0, 0.2);
      }

      .fav-tab:focus-visible {
        outline: 2px dashed var(--link-color);
        outline-offset: 6px;
      }

      .fav-icon {
        fill: currentColor;
        shape-rendering: crispEdges;
      }

      .fav-case {
        position: relative;
        padding: 75px 21px 36px;
      }

      .fav-art {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }

      .fav-panel {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 21px 12px;
      }

      .fav-panel[hidden] {
        display: none;
      }

      .fav-albums {
        grid-template-columns: repeat(9, minmax(0, 1fr));
        column-gap: 9px;
      }

      .fav-cover {
        display: block;
        box-sizing: border-box;
        width: 100%;
        height: auto;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border: 1px solid rgba(0, 0, 0, 0.45);
        box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.3);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .fav-albums .fav-cover {
        aspect-ratio: 1;
      }

      .fav-cover:hover {
        position: relative;
        z-index: 2;
        transform: translateY(-4px) scale(1.05);
        box-shadow: 4px 6px 0 rgba(0, 0, 0, 0.3);
      }

      .fav-panel.drop .fav-cover {
        animation: fav-drop 0.24s steps(3) backwards;
        animation-delay: calc(var(--i) * 30ms);
      }

      @keyframes fav-drop {
        from { transform: translateY(-12px); }
      }

      .fav-plaque {
        position: absolute;
        z-index: 2;
        left: 60px;
        right: 60px;
        bottom: 9px;
        height: 15px;
        line-height: 15px;
        font-size: 10px;
        font-weight: bold;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #4a3719;
        pointer-events: none;
      }

      body.dark .fav-plaque {
        color: #1c150c;
      }

      @media (max-width: 500px) {
        .fav-games {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .fav-albums {
          grid-template-columns: repeat(6, minmax(0, 1fr));
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .fav-panel.drop .fav-cover {
          animation: none;
        }
      }

      /* Contact me, between the bio and favorites */
      .contact-block {
        margin-top: 20px;
        padding: 12px;
        text-align: center;
        background-color: var(--status-bg);
        border: 1px solid var(--border-color);
        box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.12);
      }

      .contact-block h3 {
        margin: 0 0 8px;
        font-size: 1.1em;
      }

      .contact-email {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 1.05em;
        font-weight: bold;
      }

      .contact-icon {
        fill: currentColor;
        shape-rendering: crispEdges;
      }
{% endraw %}{% endblock %}
{% block main %}{% raw %}      <main>

