---
title: "ethnmz &mdash; daily apps"
---
{% extends "layouts/page.njk" %}
{% block pageStyle %}{% raw %}
      a:hover {
        font-style: italic;
      }

      h1, h2, h3 {
        font-family: var(--header-font);
        color: var(--link-color);
        font-style: italic;
        margin-top: 0;
        text-align: center;
      }

      /* --- TOP HEADER --- */
      .top-header {
        max-width: 900px;
        margin: 0 auto 20px auto;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 5px;
        font-style: italic;
      }

      /* --- MAIN CONTENT STYLES --- */
      .path-bar {
        font-style: italic;
        font-size: 0.9em;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 5px;
      }

      .page-header {
        font-size: 2em;
        text-align: left;
        border-bottom: 1px dashed var(--border-color);
        margin-bottom: 15px;
        font-style: normal;
      }

      .page-desc {
        font-size: 0.95em;
        margin-bottom: 15px;
      }

      /* Daily apps list: icon on the left, what it's for + screenshots on the right */
      .app {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 16px;
        padding: 18px 0;
        border-top: 1px dashed var(--border-color);
      }

      .app:first-of-type {
        border-top: 0;
        padding-top: 4px;
      }

      .app-icon {
        display: grid;
        place-items: center;
        width: 64px;
        height: 64px;
        overflow: hidden;
        border-radius: 14px;
        background: var(--brand);
        box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.25);
        color: #fff;
        font-size: 28px;
        font-weight: bold;
      }

      .app-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .app-name {
        margin: 0;
        font-size: 1.3em;
        text-align: left;
      }

      .app-tags {
        margin: 2px 0 8px;
        font-size: 0.85em;
        font-style: italic;
        color: var(--link-color);
      }

      .app-body > p {
        margin: 0 0 12px;
      }

      .app-shots {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        align-items: start;
      }

      .app-shots .shot {
        display: block;
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        cursor: var(--cursor-zoom-in);
      }

      .app-shots .shot:focus-visible {
        outline: 2px dashed var(--link-color);
        outline-offset: 3px;
      }

      .app-shots img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border-color);
        box-shadow: var(--hard-shadow);
        transition: transform 0.15s ease;
      }

      .app-shots .shot:hover img {
        transform: translateY(-3px);
      }

      /* enlarged screenshot */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 1005;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(20, 16, 12, 0.78);
        cursor: var(--cursor-zoom-out);
      }

      .lightbox[hidden] {
        display: none;
      }

      .lightbox img {
        display: block;
        max-width: min(92vw, 1500px);
        max-height: 86vh;
        width: auto;
        height: auto;
        border: 1px solid var(--border-color);
        box-shadow: 6px 8px 0 rgba(0, 0, 0, 0.35);
        animation: v2-pop 0.2s steps(3) both;
      }

      .lightbox-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 34px;
        height: 34px;
        border: 1px solid var(--border-color);
        background: var(--box-bg);
        color: var(--text-color);
        font-family: var(--body-font);
        font-size: 18px;
        line-height: 1;
        cursor: var(--cursor-pointer);
        box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.3);
      }

      @media (prefers-reduced-motion: reduce) {
        .lightbox img {
          animation: none;
        }
      }

      @media (max-width: 500px) {
        .app {
          grid-template-columns: 44px minmax(0, 1fr);
          gap: 12px;
        }

        .app-icon {
          width: 44px;
          height: 44px;
          border-radius: 10px;
          font-size: 20px;
        }

        .app-shots {
          grid-template-columns: minmax(0, 1fr);
        }
      }
{% endraw %}{% endblock %}
{% block main %}{% raw %}      <main>

        <div class="box path-bar" data-scene="apps">
          <strong>daily apps</strong>
        </div>

        <div class="box">
          <h1 class="page-header">daily apps</h1>

          <p class="page-desc">
            the apps i open every day and what i actually use them for. mostly productivity stuff.
          </p>

{% endraw %}{% for app in apps %}{% if not loop.first %}
{% endif %}          <article class="app" id="{{ app.id }}" style="--brand: {{ app.brand }}">
            <div class="app-icon" aria-hidden="true"><img src="{{ app.icon }}" alt=""></div>
            <div class="app-body">
              <h2 class="app-name">{{ app.name | safe }}</h2>
              <p class="app-tags">[{{ app.tags | join("] [") | safe }}]</p>
              <p>{{ app.about | safe }}</p>
              <div class="app-shots">
{% for s in app.shots %}                <button type="button" class="shot"><img src="{{ s.src }}" alt="{{ s.alt | safe }}" loading="lazy"></button>
{% endfor %}              </div>
            </div>
          </article>
{% endfor %}{% raw %}        </div>

      </main>

{% endraw %}{% endblock %}
{% block scriptExtra %}{% raw %}
      (function () {
        var box = document.createElement('div');
        box.className = 'lightbox';
        box.hidden = true;
        box.setAttribute('role', 'dialog');
        box.setAttribute('aria-modal', 'true');
        box.setAttribute('aria-label', 'enlarged screenshot');
        box.innerHTML = '<img alt=""><button type="button" class="lightbox-close" aria-label="close">&times;</button>';
        document.body.appendChild(box);
        var big = box.querySelector('img');
        var closeBtn = box.querySelector('.lightbox-close');
        var opener = null;

        function open(btn) {
          var img = btn.querySelector('img');
          opener = btn;
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          box.hidden = false;
          closeBtn.focus();
        }

        function close() {
          if (box.hidden) return;
          box.hidden = true;
          if (opener) opener.focus({ preventScroll: true });
          opener = null;
        }

        document.querySelectorAll('.app-shots .shot').forEach(function (btn) {
          btn.addEventListener('click', function () { open(btn); });
        });
        box.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (box.hidden) return;
          if (e.key === 'Escape') close();
          if (e.key === 'Tab') { e.preventDefault(); closeBtn.focus(); }
        });
      })();
{% endraw %}{% endblock %}
