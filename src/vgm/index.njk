---
title: "ethnmz &mdash; vg song of the day"
---
{% extends "layouts/page.njk" %}
{% block pageStyle %}{% raw %}
      h1, h2, h3 {
        font-family: var(--header-font);
        color: var(--link-color);
        margin-top: 0;
        text-align: center;
      }

      /* --- TOP HEADER --- */
      .top-header {
        max-width: 900px;
        margin: 0 auto 20px auto;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 5px;
      }

      /* --- MAIN CONTENT STYLES --- */
      .path-bar {
        font-size: 0.9em;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 5px;
      }

      .page-header {
        font-size: 2em;
        text-align: left;
        border-bottom: 1px dashed var(--border-color);
        margin-bottom: 15px;
      }

      .page-desc {
        font-size: 0.95em;
        margin-bottom: 15px;
      }

      /* Now Playing Specifics */
      .np-disc-wrap {
        position: relative;
        width: 150px;
        height: 150px;
        margin: 5px auto 10px auto;
      }

      .np-disc {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        object-fit: cover;
        display: block;
        cursor: var(--cursor-pointer);
        animation: np-spin 6s linear infinite;
        animation-play-state: paused;
      }

      .np-disc.playing {
        animation-play-state: running;
      }

      .np-disc-hole {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 18px;
        height: 18px;
        margin: -9px 0 0 -9px;
        background: var(--box-bg);
        border: 1px solid var(--border-color);
        border-radius: 50%;
        pointer-events: none;
      }

      @keyframes np-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .np-info {
        text-align: center;
        margin-bottom: 10px;
      }

      .np-track {
        font-weight: bold;
      }

      .np-game {
        font-size: 0.9em;
      }

      .np-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 auto 10px auto;
        max-width: 320px;
      }

      .np-btn {
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--select-bg);
        border: 1px solid var(--border-color);
        color: var(--text-color);
        font-family: var(--body-font);
        font-size: 0.7em;
        cursor: var(--cursor-pointer);
      }

      .np-btn:hover {
        background: var(--border-color);
      }

      .np-seek {
        flex: 1;
        height: 8px;
        background: var(--select-bg);
        border: 1px solid var(--border-color);
        border-radius: 3px;
        overflow: hidden;
        cursor: var(--cursor-pointer);
      }

      .np-seek-fill {
        height: 100%;
        width: 0%;
        background: var(--link-color);
      }

      .np-time {
        font-size: 0.75em;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .np-footer {
        font-size: 0.85em;
        text-align: center;
      }

      .np-embed-hidden {
        position: absolute;
        width: 2px;
        height: 2px;
        overflow: hidden;
        opacity: 0.01;
        pointer-events: none;
      }

      .np-embed-hidden iframe {
        width: 2px;
        height: 2px;
      }

      /* Archive list */
      .archive-list {
        margin-top: 5px;
      }

      .archive-item {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        padding: 6px 0;
        border-bottom: 1px dashed var(--border-color);
      }

      .archive-item:last-child {
        border-bottom: none;
      }

      .archive-date {
        font-weight: bold;
        color: var(--link-color);
        flex-shrink: 0;
        font-size: 0.85em;
      }

      .archive-title {
        flex: 1;
        text-align: right;
        font-size: 0.85em;
      }

      @media (max-width: 480px) {
        .archive-item {
          flex-direction: column;
          align-items: flex-start;
          gap: 2px;
        }

        .archive-title {
          text-align: left;
        }
      }
{% endraw %}{% endblock %}
{% block main %}{% raw %}      <main>

        <div class="box path-bar" data-scene="vgm">
          <strong>vg song of the day</strong>
        </div>

        <div class="box">
          <h1 class="page-header">vg song of the day</h1>

         

          <div class="np-disc-wrap">
            <img src="/media/album-cover.png" class="np-disc" id="np-cover" alt="album art" title="click to play/pause">
            <div class="np-disc-hole"></div>
          </div>

          <div class="np-info">
            <div class="np-track" id="np-track">loading&hellip;</div>
            <a class="np-game" id="np-yt-link" href="#" target="_blank" rel="noopener">listen on youtube &#8599;</a>
          </div>

          <div class="np-controls">
            <button class="np-btn" id="np-play-btn" aria-label="play">&#9658;</button>
            <div class="np-seek" id="np-seek">
              <div class="np-seek-fill" id="np-bar-fill"></div>
            </div>
            <span class="np-time" id="np-time">0:00 / 0:00</span>
            <button class="np-btn" id="np-mute-btn" aria-label="unmute"><svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M15.5 9.5l5 5M20.5 9.5l-5 5"/></svg></button>
          </div>

          <div class="np-embed-hidden">
            <iframe id="np-embed" src="" title="song of the day" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
          </div>
        </div>

        <div class="box">
          <h3>archive</h3>
          <hr class="dashed">
          <div class="archive-list" id="archive-list">loading&hellip;</div>
        </div>

      </main>

{% endraw %}{% endblock %}
{% block scriptExtra %}{% raw %}
      (function () {
        // full playlist data lives in playlist.json: https://youtube.com/playlist?list=PLOi1NEWTH8AZkcayv6PgvfVxA_kXaN8py
        var cover = document.getElementById('np-cover');
        var iframe = document.getElementById('np-embed');
        var trackLabel = document.getElementById('np-track');
        var ytLink = document.getElementById('np-yt-link');
        var playBtn = document.getElementById('np-play-btn');
        var muteBtn = document.getElementById('np-mute-btn');
        var seek = document.getElementById('np-seek');
        var seekFill = document.getElementById('np-bar-fill');
        var timeLabel = document.getElementById('np-time');
        var archiveList = document.getElementById('archive-list');
        var ytPlayer = null;
        var pollTimer = null;

        function formatTime(seconds) {
          if (!isFinite(seconds)) return '0:00';
          var m = Math.floor(seconds / 60);
          var s = Math.floor(seconds % 60);
          return m + ':' + (s < 10 ? '0' : '') + s;
        }

        function updateProgress() {
          if (!ytPlayer || !ytPlayer.getDuration) return;
          var duration = ytPlayer.getDuration();
          var current = ytPlayer.getCurrentTime();
          if (duration) {
            seekFill.style.width = (current / duration * 100) + '%';
          }
          timeLabel.textContent = formatTime(current) + ' / ' + formatTime(duration);
        }

        function togglePlay() {
          if (!ytPlayer || !ytPlayer.getPlayerState) return;
          var state = ytPlayer.getPlayerState();
          if (state === YT.PlayerState.PLAYING) {
            ytPlayer.pauseVideo();
          } else {
            ytPlayer.playVideo();
          }
        }

        var muteIcon = '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M15.5 9.5l5 5M20.5 9.5l-5 5"/></svg>';
        var unmuteIcon = '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"/></svg>';

        function toggleMute() {
          if (!ytPlayer || !ytPlayer.isMuted) return;
          if (ytPlayer.isMuted()) {
            ytPlayer.unMute();
            muteBtn.innerHTML = unmuteIcon;
            muteBtn.setAttribute('aria-label', 'mute');
          } else {
            ytPlayer.mute();
            muteBtn.innerHTML = muteIcon;
            muteBtn.setAttribute('aria-label', 'unmute');
          }
        }

        function seekToClientX(clientX) {
          if (!ytPlayer || !ytPlayer.getDuration) return;
          var rect = seek.getBoundingClientRect();
          var ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
          var duration = ytPlayer.getDuration();
          if (duration) {
            ytPlayer.seekTo(ratio * duration, true);
          }
        }

        function onPlayerStateChange(e) {
          if (e.data === YT.PlayerState.PLAYING) {
            cover.classList.add('playing');
            playBtn.innerHTML = '&#10074;&#10074;';
            playBtn.setAttribute('aria-label', 'pause');
            if (!pollTimer) pollTimer = setInterval(updateProgress, 250);
          } else {
            cover.classList.remove('playing');
            playBtn.innerHTML = '&#9658;';
            playBtn.setAttribute('aria-label', 'play');
            if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) {
              clearInterval(pollTimer);
              pollTimer = null;
              updateProgress();
            }
          }
        }

        function onPlayerReady(e) {
          e.target.mute();
          e.target.playVideo();
        }

        function initPlayer() {
          ytPlayer = new YT.Player('np-embed', {
            events: { onReady: onPlayerReady, onStateChange: onPlayerStateChange }
          });
        }

        window.onYouTubeIframeAPIReady = initPlayer;

        cover.addEventListener('click', togglePlay);
        playBtn.addEventListener('click', togglePlay);
        muteBtn.addEventListener('click', toggleMute);
        seek.addEventListener('click', function (e) {
          seekToClientX(e.clientX);
        });

        function renderArchive(playlist, dayIndex) {
          var html = '';
          for (var i = 0; i < 14; i++) {
            var idx = ((dayIndex - i) % playlist.length + playlist.length) % playlist.length;
            var track = playlist[idx];
            var date = new Date(Date.now() - i * 86400000);
            var dateStr = date.toISOString().slice(0, 10);
            html += '<div class="archive-item">' +
              '<span class="archive-date">' + dateStr + '</span>' +
              '<a class="archive-title" href="https://youtu.be/' + track.id + '" target="_blank" rel="noopener">' + track.title + '</a>' +
              '</div>';
          }
          archiveList.innerHTML = html;
        }

        fetch('/playlist.json')
          .then(function (res) { return res.json(); })
          .then(function (playlist) {
            var dayIndex = Math.floor(Date.now() / 86400000) % playlist.length;
            var today = playlist[dayIndex];

            cover.src = 'https://img.youtube.com/vi/' + today.id + '/mqdefault.jpg';
            trackLabel.textContent = today.title;
            ytLink.href = 'https://youtu.be/' + today.id;
            iframe.src = 'https://www.youtube-nocookie.com/embed/' + today.id + '?rel=0&modestbranding=1&enablejsapi=1&autoplay=1&mute=1';

            renderArchive(playlist, dayIndex);

            var ytScript = document.createElement('script');
            ytScript.src = 'https://www.youtube.com/iframe_api';
            document.body.appendChild(ytScript);
          })
          .catch(function () {
            trackLabel.textContent = 'could not load playlist';
            archiveList.textContent = 'could not load playlist';
          });
      })();
{% endraw %}{% endblock %}
